{% extends "_layouts/cp" %}

{% import '_includes/forms.twig' as forms %}

{%
    set crumbs = [
        { 'label': 'Redirector'|t('pxx-redirector'), 'url': url('pxx-redirector') },
        { 'label': 'Redirects'|t('pxx-redirector'), 'url': url('redirector/redirects') },
        { 'label': isNew ? 'New Redirect'|t('pxx-redirector') : 'Editing Redirect'|t('pxx-redirector') },
    ]
%}
{% set title = isNew ? 'New Redirect'|t('pxx-redirector') : 'Editing Redirect'|t('pxx-redirector') %}
{% set selectedSubnavItem = 'redirects' %}
{% set fullPageForm = false %}
{% set actionButton %}
    <div x-cloak x-data="headerComponent">
        <button class="btn submit" @click="save(true)">
            {{ 'Save'|t('pxx-redirector') }}
        </button>
        <div @keydown.window.prevent.ctrl.s="save(false)" @keydown.window.prevent.meta.s="save(false)"></div>
    </div>
{% endset %}

{% block content %}
    <div x-cloak x-data="pageComponent" @save-page.window="save($event)">
        <div class="tw:flex tw:flex-wrap tw:gap-x-5 tw:gap-y-10 tw:*:m-0!">
            <div class="tw:w-full tw:[&_.field]:mb-2!">
                {{
                    forms.lightswitchField({
                        label: 'Enabled'|t('pxx-redirector'),
                        name: 'enabled',
                        on: data.enabled,
                        containerAttributes: {
                            'x-ref': 'enabledSwitch',
                            '@click': 'syncFromDom($el)',
                            'x-effect': 'syncToDom($el)',
                        }
                    })
                }}
            </div>
            <div class="tw:w-full tw:[&_.field]:mb-2!">
                {{
                    forms.selectField({
                        label: 'Site'|t('pxx-redirector'),
                        name: 'siteHandle',
                        options: sites,
                        inputAttributes: {
                            'x-model': 'data.siteHandle',
                        }
                    })
                }}
            </div>
            <div class="tw:w-full tw:lg:w-[calc((100%-20px)*(1/2))] tw:[&_.field]:mb-2!">
                {{
                    forms.textField({
                        label: 'Redirect From'|t('pxx-redirector'),
                        instructions: 'Enter the old URL\'s path (part of the URL after the domain name; e.g. www.example.com<strong>/old-url</strong>)',
                        name: 'oldUrl',
                        inputAttributes: {
                            'x-model': 'data.oldUrl',
                        }
                    })
                }}
                <div class="instructions">
                    <p>
                        {{ 'In case of RegEx match type, RegEx patterns can be defined in Redirect From URL path. (More on <a href="https://regex101.com/" target="_blank">https://regex101.com/</a>)'|t('pxx-redirector')|raw }}
                    </p>
                </div>
                <div x-show="errors.oldUrl" class="tw:text-red-600 tw:mt-1" x-text="errors.oldUrl"></div>
            </div>
            <div class="tw:w-full tw:lg:w-[calc((100%-20px)*(1/2))] tw:[&_.field]:mb-2!">
                <div class="field">
                    <div class="heading">
                        <label for="newUrl">{{ 'Redirect To'|t('pxx-redirector') }}</label>                        
                    </div>
                    <div class="instructions">
                        <p>{{ 'Enter the new URL\'s path (part of the URL after the domain name; e.g. www.example.com<strong>/new-url</strong>)'|t('pxx-redirector')|raw }}</p>
                    </div>
                    <div class="tw:relative">
                        {{
                            forms.text({
                                name: 'newUrl',
                                inputAttributes: {
                                    'id' : 'newUrl',
                                    'x-model': 'data.newUrl',
                                }
                            })
                        }}
                        {% if enableAi %}
                            <button type="button" class="btn tw:absolute! tw:top-1/2! tw:right-1! tw:-translate-y-1/2! tw:h-[26px]! tw:min-h-[26px]! tw:flex! tw:items-center! tw:gap-x-1! tw:ml-2! tw:hover:opacity-75!" @click="aiSuggestions()">
                                <div x-show="!aiBusy">
                                    {{ svg('@app/icons/solid/star-christmas.svg')|attr({ 'class': 'tw:w-4 tw:h-4 tw:fill-gray-500' }) }}
                                </div>
                                {# loader #}
                                <div x-show="aiBusy" class="tw:flex tw:justify-center tw:items-center tw:self-center">
                                    <svg aria-hidden="true" class="tw:w-4 tw:h-4 tw:text-gray-200 tw:animate-spin tw:fill-gray-500" viewBox="0 0 100 101" fill="none" xmlns="http://www.w3.org/2000/svg">
                                        <path d="M100 50.5908C100 78.2051 77.6142 100.591 50 100.591C22.3858 100.591 0 78.2051 0 50.5908C0 22.9766 22.3858 0.59082 50 0.59082C77.6142 0.59082 100 22.9766 100 50.5908ZM9.08144 50.5908C9.08144 73.1895 27.4013 91.5094 50 91.5094C72.5987 91.5094 90.9186 73.1895 90.9186 50.5908C90.9186 27.9921 72.5987 9.67226 50 9.67226C27.4013 9.67226 9.08144 27.9921 9.08144 50.5908Z" fill="currentColor"/>
                                        <path d="M93.9676 39.0409C96.393 38.4038 97.8624 35.9116 97.0079 33.5539C95.2932 28.8227 92.871 24.3692 89.8167 20.348C85.8452 15.1192 80.8826 10.7238 75.2124 7.41289C69.5422 4.10194 63.2754 1.94025 56.7698 1.05124C51.7666 0.367541 46.6976 0.446843 41.7345 1.27873C39.2613 1.69328 37.813 4.19778 38.4501 6.62326C39.0873 9.04874 41.5694 10.4717 44.0505 10.1071C47.8511 9.54855 51.7191 9.52689 55.5402 10.0491C60.8642 10.7766 65.9928 12.5457 70.6331 15.2552C75.2735 17.9648 79.3347 21.5619 82.5849 25.841C84.9175 28.9121 86.7997 32.2913 88.1811 35.8758C89.083 38.2158 91.5421 39.6781 93.9676 39.0409Z" fill="currentFill"/>
                                    </svg>
                                    <span class="tw:sr-only">Loading...</span>
                                </div>
                                <span class="tw:font-bold tw:text-gray-500">AI</span>
                            </button>
                            <div x-cloak x-show="aiPopup" class="tw:absolute tw:top-full tw:mt-1 tw:left-0 tw:w-full tw:pb-2 tw:bg-white tw:shadow! tw:border! tw:border-gray-300! tw:rounded tw:z-50">
                                <div class="tw:flex tw:justify-between tw:px-2 tw:py-2">
                                    <div class="tw:font-bold">{{ 'Suggestions'|t('pxx-redirector') }}</div>
                                    <button class="" type="button" @click="aiPopup = false;">
                                        {{ svg('@app/icons/solid/x.svg')|attr({ 'class': 'tw:w-4 tw:h-4 tw:fill-gray-500' }) }}
                                    </button>
                                </div>
                                <template x-for="aiPopupRow in aiPopupRows">
                                    <button class="tw:w-[calc(100%-16px)] tw:px-2! tw:py-2! tw:mx-2! tw:my-0.5! tw:bg-gray-50! tw:hover:bg-gray-100! tw:transition-all! tw:rounded tw:cursor-pointer" @click="setNewUrl(aiPopupRow)">
                                        <div class="tw:text-left tw:font-semibold" x-text="aiPopupRow"></div>
                                    </button>
                                </template>
                                <div x-show="!aiPopupRows.length" class="tw:px-2 tw:py-2">
                                    <div class="tw:font-bold tw:text-sm tw:text-center">{{ 'No suggestions'|t('pxx-redirector') }}</div>
                                </div>
                                <div x-show="aiPopupError !== ''" class="tw:px-2 tw:py-2">
                                    <div class="tw:font-bold tw:text-red-600 tw:text-sm tw:text-center" x-html="aiPopupError"></div>
                                </div>
                            </div>
                        {% endif %}
                    </div>
                </div>
                <div class="instructions">
                    <p>
                        {{ 'In case of RegEx match type, RegEx capture groups can be used in Redirect To URL path. (More on <a href="https://regex101.com/" target="_blank">https://regex101.com/</a>)'|t('pxx-redirector')|raw }}
                    </p>
                </div>
                <div x-show="errors.newUrl" class="tw:text-red-600 tw:mt-1" x-text="errors.newUrl"></div>
            </div>
            <div class="tw:w-full tw:[&_.field]:mb-2!">
                {{
                    forms.selectField({
                        label: 'Redirect Type'|t('pxx-redirector'),
                        instructions: 'Select which type of redirect should be performed'|t('pxx-redirector'),
                        name: 'httpCode',
                        options: {
                            all: {
                                label: 'Select'|t('pxx-redirector'),
                                value: '',
                            },
                            301: {
                                label: '301 Moved Permanently',
                                value: '301',
                            },
                            302: {
                                label: '302 Found (Moved Temporarily)',
                                value: '302',
                            },                            
                            307: {
                                label: '307 Temporary Redirect',
                                value: '307',
                            },
                            308: {
                                label: '308 Permanent Redirect',
                                value: '308',
                            },
                            410: {
                                label: '410 Gone',
                                value: '410',
                            },
                        },
                        inputAttributes: {
                            'x-model': 'data.httpCode',
                        }
                    })
                }}
                <div x-show="errors.httpCode" class="tw:text-red-600 tw:mt-1" x-text="errors.httpCode"></div>
            </div>
            <div class="tw:w-full tw:lg:w-[calc((100%-60px)*(1/4))] tw:[&_.field]:mb-2!">
                {{
                    forms.selectField({
                        label: 'Match Type'|t('pxx-redirector'),
                        instructions: 'The type of match to apply to the Redirect From value'|t('pxx-redirector'),
                        name: 'matchType',
                        options: {
                            all: {
                                label: 'Select'|t('pxx-redirector'),
                                value: '',
                            },
                            exact: {
                                label: 'Exact Match'|t('pxx-redirector'),
                                value: 'exact',
                            },
                            regex: {
                                label: 'RegEx Match'|t('pxx-redirector'),
                                value: 'regex',
                            },
                        },
                        inputAttributes: {
                            'x-model': 'data.matchType',
                        }
                    })
                }}
                <div x-show="errors.matchType" class="tw:text-red-600 tw:mt-1" x-text="errors.matchType"></div>
            </div>
            <div x-show="data.matchType == 'regex'" class="tw:w-full tw:lg:w-[calc((100%-60px)*(1/4))] tw:[&_.field]:mb-2!">
                {{
                    forms.textField({
                        label: 'Priority'|t('pxx-redirector'),
                        instructions: 'Define the priority for this redirect. (Higher values takes precedence)'|t('pxx-redirector'),
                        name: 'priority',
                        inputAttributes: {
                            'x-model': 'data.priority',
                        }
                    })
                }}
                <div x-show="errors.priority" class="tw:text-red-600 tw:mt-1" x-text="errors.priority"></div>
            </div>
        </div>
    </div>
    <script>
        document.addEventListener('alpine:init', () => {
            window.axios.defaults.headers.common['Accept'] = 'application/json';
            window.axios.defaults.headers.common['Content-Type'] = 'application/json';
            window.axios.defaults.headers.common['X-CSRF-Token'] = '{{ craft.app.request.getCsrfToken()}}';
            
            Alpine.data('headerComponent', () => ({
                save: function(redirectToIndex) {
                    let self = this;

                    self.$dispatch('save-page', { 'redirectToIndex': redirectToIndex });
                },
            }));

            Alpine.data('pageComponent', () => ({
                initializing: true,
                busy: false,
                aiBusy: false,
                aiOldUrl: '',
                aiPopup: false,
                aiPopupError: '',
                aiPopupRows: [],
                data: {{ data|json_encode|raw }},
                errors: {{ errors|json_encode|raw }},
                init() {
                    let self = this;

                    console.log('Redirect page init');
                },
                save: function($event) {
                    let self = this;

                    let redirectToIndex = $event.detail.redirectToIndex;

                    if (self.busy) return;

                    self.busy = true;

                    axios.post('{{ cpUrl('redirector/redirects/save-redirect') }}', self.data)
                        .then(function(response) {
                            let responseData = response.data;

                            self.busy = false;
                            if (redirectToIndex) {
                                window.location.href = '{{ cpUrl('redirector/redirects')|split('?')|first }}';
                            }
                            else {
                                if (self.data.uid == 'new') {
                                    window.location.href = '{{ cpUrl('redirector/redirects')|split('?')|first }}/' + responseData.uid;
                                }
                                else {
                                    self.data = responseData;
                                    Craft.cp.displaySuccess('{{ 'Save Completed!'|t('pxx-redirector') }}');
                                }
                            }                            
                        })
                        .catch(function(error) {
                            let responseData = error.response.data;

                            if (error.response.status == 400) {
                                let errors = error.response.data;

                                self.resetErrors();

                                for (errorKey in errors) {
                                    self.errors[errorKey] = errors[errorKey].join('<br>')
                                }
                            }
                            else {
                                Craft.cp.displayError('{{ 'An error has occured!'|t('pxx-redirector') }}');
                            }
                        })
                        .finally(function() {
                            self.busy = false;
                        });
                },
                resetErrors: function() {
                    let self = this;
                    
                    for (errorKey of Object.keys(self.errors)) {
                        self.errors[errorKey] = '';
                    }
                },
                aiSuggestions: function() {
                    let self = this;

                    if (self.aiOldUrl !== '' && self.data.oldUrl == self.aiOldUrl) {
                        self.aiPopup = true;
                        return;
                    }

                    if (self.aiBusy) return;

                    self.aiBusy = true;
                    self.aiPopup = false;
                    self.aiPopupError = '';

                    axios.post('{{ cpUrl('redirector/ai/get-suggestions') }}', { oldUrl: self.data.oldUrl, siteHandle: self.data.siteHandle })
                        .then(function(response) {
                            let responseData = response.data;

                            self.aiPopup = true;

                            if (responseData.success) {
                                self.aiOldUrl = self.data.oldUrl;
                                self.aiPopupRows = responseData.data.urls;
                            }
                            else {
                                self.aiPopupError = responseData.message;
                            }
                        })
                        .catch(function(error) {
                            let responseData = error.response.data;

                            Craft.cp.displayError('{{ 'An error has occured!'|t('pxx-redirector') }}');
                        })
                        .finally(function() {
                            self.aiBusy = false;
                        });
                },
                setNewUrl: function(newUrl) {
                    let self = this;

                    self.data.newUrl = newUrl;
                    self.aiPopup = false;
                },
                syncFromDom(el) {
                    let self = this;

                    self.data.enabled = el.classList.contains('on');
                },
                syncToDom(el) {
                    let self = this;
                    
                    const isOn = !!self.data.enabled;
                    el.classList.toggle('on', isOn);
                    el.setAttribute('aria-checked', isOn ? 'true' : 'false');
                    const input = el.querySelector('input[type="hidden"][name="enabled"]');
                    if (input) {
                        input.value = isOn ? '1' : '';
                    }
                },
            }));
        });
    </script>
{% endblock %}
