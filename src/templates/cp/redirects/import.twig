{% extends "_layouts/cp" %}

{% import '_includes/forms.twig' as forms %}

{%
    set crumbs = [
        { 'label': 'Redirector'|t('redirector'), 'url': url('redirector') },
        { 'label': 'Redirects'|t('redirector'), 'url': url('redirector/redirects') },
        { 'label': 'Import CSV'|t('redirector') },
    ]
%}
{% set title = 'Import CSV'|t('redirector') %}
{% set selectedSubnavItem = 'redirects' %}
{% set submitButtonLabel = 'Import CSV' %}
{% set fullPageForm = false %}

{% set actionButton %}
    <div x-cloak x-data="headerComponent">
        <button class="btn submit" @click="importCsv()">
            {{ 'Import CSV'|t('redirector') }}
        </button>
    </div>
{% endset %}

{% block content %}
    <div x-cloak x-data="pageComponent" @import-csv.window="importCsv()">
        <div class="tw:flex tw:items-start tw:gap-x-5">
            <div>
                {{
                    forms.selectField({
                        label: 'Separator'|t('redirector'),
                        name: 'separator',
                        options: {
                            comma: {
                                label: ',',
                                value: ',',
                            },
                            semicolon: {
                                label: ';',
                                value: ';',
                            },
                        },
                        inputAttributes: {
                            'x-model': "separator",
                        }
                    })
                }}
            </div>
            <div class="tw:[&_.field]:mb-2!">                
                {{
                    forms.fileField({
                        label: 'CSV File'|t('redirector'),
                        name: 'file',
                        inputAttributes: {
                            '@change': "handleFileSelect",
                        }
                    })
                }}
                <div x-show="error" class="tw:text-red-600 tw:mt-1" x-text="error"></div>
            </div>
            <div x-cloak x-show="busy" class="tw:flex tw:justify-center tw:items-center tw:self-center">
                <svg aria-hidden="true" class="tw:w-6 tw:h-6 tw:text-gray-200 tw:animate-spin tw:fill-gray-500" viewBox="0 0 100 101" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M100 50.5908C100 78.2051 77.6142 100.591 50 100.591C22.3858 100.591 0 78.2051 0 50.5908C0 22.9766 22.3858 0.59082 50 0.59082C77.6142 0.59082 100 22.9766 100 50.5908ZM9.08144 50.5908C9.08144 73.1895 27.4013 91.5094 50 91.5094C72.5987 91.5094 90.9186 73.1895 90.9186 50.5908C90.9186 27.9921 72.5987 9.67226 50 9.67226C27.4013 9.67226 9.08144 27.9921 9.08144 50.5908Z" fill="currentColor"/>
                    <path d="M93.9676 39.0409C96.393 38.4038 97.8624 35.9116 97.0079 33.5539C95.2932 28.8227 92.871 24.3692 89.8167 20.348C85.8452 15.1192 80.8826 10.7238 75.2124 7.41289C69.5422 4.10194 63.2754 1.94025 56.7698 1.05124C51.7666 0.367541 46.6976 0.446843 41.7345 1.27873C39.2613 1.69328 37.813 4.19778 38.4501 6.62326C39.0873 9.04874 41.5694 10.4717 44.0505 10.1071C47.8511 9.54855 51.7191 9.52689 55.5402 10.0491C60.8642 10.7766 65.9928 12.5457 70.6331 15.2552C75.2735 17.9648 79.3347 21.5619 82.5849 25.841C84.9175 28.9121 86.7997 32.2913 88.1811 35.8758C89.083 38.2158 91.5421 39.6781 93.9676 39.0409Z" fill="currentFill"/>
                </svg>
                <span class="tw:sr-only">Loading...</span>
            </div>
        </div>
        <div class="pane">
            <h3>{{ 'CSV requirements'|t('redirector') }}</h3>
            <p>{{ 'The file must be a <strong>.csv</strong> file (comma or semicolon separated).<br>The first row must contain the columns headings that will be used to link the files\' columns to the databases\' columns.<br>A valid import file must contain at least the <strong>oldUrl</strong> and the <strong>newUrl</strong> columns. All other columns, if not available in the file, will fallback to their default values.'|t('redirector')|raw }}</h3></p>
            <table>
                <thead>
                    <th>{{ 'Column'|t('redirector') }}</th>
                    <th>{{ 'Description'|t('redirector') }}</th>
                    <th>{{ 'Requirement'|t('redirector') }}</th>
                    <th>{{ 'Default'|t('redirector') }}</th>
                    <th>{{ 'Valid Values'|t('redirector') }}</th>
                </thead>
                <tbody>
                    <tr>
                        <td>enabled</td>
                        <td>{{ 'Enables/disables the redirect'|t('redirector') }}</td>
                        <td>{{ 'Optional'|t('redirector') }}</td>
                        <td><code>true</code></td>
                        <td><code>true</code>, <code>false</code>, <code>1</code>, <code>0</code></td>
                    </tr>
                    <tr>
                        <td>siteId</td>
                        <td>{{ 'The site to which the redirect will apply to'|t('redirector') }}</td>
                        <td>{{ 'Optional'|t('redirector') }}</td>
                        <td>-</td>
                        <td></td>
                    </tr>
                    <tr>
                        <td>oldUrl</td>
                        <td>{{ 'Old Url (absolute urls will be converted to relative paths)'|t('redirector') }}</td>
                        <td>{{ 'Required'|t('redirector') }}</td>
                        <td></td>
                        <td></td>
                    </tr>
                    <tr>
                        <td>newUrl</td>
                        <td>{{ 'New Url (absolute urls will be converted to relative paths)'|t('redirector') }}</td>
                        <td>{{ 'Required'|t('redirector') }}</td>
                        <td></td>
                        <td></td>
                    </tr>
                    <tr>
                        <td>matchType</td>
                        <td>{{ 'The matching type for oldUrl column\'s value'|t('redirector') }}</td>
                        <td>{{ 'Optional'|t('redirector') }}</td>
                        <td>exact</td>
                        <td>exact, regex</td>
                    </tr>
                    <tr>
                        <td>priority</td>
                        <td>{{ 'Priority of the redirect rule (only for matchType regex)'|t('redirector') }}</td>
                        <td>{{ 'Optional'|t('redirector') }}</td>
                        <td>-</td>
                        <td>10, 20, ...</td>
                    </tr>
                    <tr>
                        <td>httpCode</td>
                        <td>{{ 'HTTP code that the redirect will send in the response'|t('redirector') }}</td>
                        <td>{{ 'Optional'|t('redirector') }}</td>
                        <td>301</td>
                        <td>301, 302, 307, 308, 410</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
    <script>
        document.addEventListener('alpine:init', () => {
            window.axios.defaults.headers.common['Accept'] = 'application/json';
            window.axios.defaults.headers.common['X-CSRF-Token'] = '{{ craft.app.request.getCsrfToken()}}';
            
            Alpine.data('headerComponent', () => ({
                importCsv: function() {
                    let self = this;

                    self.$dispatch('import-csv');
                },
            }));

            Alpine.data('pageComponent', () => ({
                initializing: true,
                busy: false,
                file: null,
                separator: ',',
                error: '',
                init() {
                    let self = this;

                    console.log('Import page init');
                },
                handleFileSelect: function(event) {
                    let self = this;

                    self.file = event.target.files?.[0] ?? null;
                },
                importCsv: function() {
                    let self = this;

                    if (self.busy) return;

                    self.busy = true;

                    const formData = new FormData();
                    formData.append('separator', self.separator);
                    formData.append('file', self.file);

                    axios.post('{{ cpUrl('redirector/redirects/import-csv') }}', formData)
                        .then(function(response) {
                            let responseData = response.data;

                            window.location.href = '{{ cpUrl('redirector/redirects')|split('?')|first }}';
                        })
                        .catch(function(error) {
                            let responseData = error.response.data;

                            self.error = '';

                            if (error.response.status == 400) {
                                let errorData = error.response.data;

                                self.error = errorData.error;
                            }
                            else {                                
                                Craft.cp.displayError('{{ 'An error has occured!'|t('redirector') }}');
                            }
                        })
                        .finally(function() {
                            self.busy = false;
                        });
                },                
            }));
        });
    </script>
{% endblock %}
